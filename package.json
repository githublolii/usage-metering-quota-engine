{
  "name": "usage-metering-quota-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Mission-critical multi-tenant usage metering and quota engine (TypeScript + PostgreSQL) with pessimistic locking, idempotency, and zero-overrun guarantees.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/database/migrator.ts up",
    "migrate:status": "tsx src/database/migrator.ts status",
    "seed": "tsx scripts/seed.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "serve": "tsx scripts/serve.ts",
    "demo": "tsx src/client/demo.ts",
    "load-test": "tsx perf/load-test.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:concurrency": "vitest run tests/concurrency",
    "test:idempotency": "vitest run tests/concurrency/idempotency-race.test.ts",
    "test:plan-change": "vitest run tests/concurrency/plan-mutation-race.test.ts",
    "test:security": "vitest run tests/integration/api.test.ts tests/integration/auth-and-validation.test.ts tests/integration/plans-crud.test.ts",
    "test:monthly-reset": "vitest run tests/integration/monthly-reset.test.ts",
    "test:boundary": "vitest run tests/unit/rules.test.ts",
    "test:property": "vitest run tests/unit/property.test.ts tests/integration/property-stress.test.ts"
  },
  "keywords": [
    "metering",
    "quota",
    "rate-limiting",
    "postgresql",
    "typescript",
    "idempotency",
    "multi-tenant"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1",
    "picocolors": "^1.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^17.5.0-beta.15",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "undici": "^8.12.2",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.5.0-beta.15": true,
    "esbuild@0.28.2": true
  }
}
