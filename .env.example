# ---------------------------------------------------------------------------
# Usage Metering & Quota Engine — environment template
# Copy to `.env` and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP port the API server listens on
PORT=3000

# PostgreSQL connection string (required)
# Local docker-compose default:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/metering

# pg.Pool sizing & tuning (see src/database/connection.ts)
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Comma-separated list of allowed CORS origins. Empty/omitted = reflect origin.
# CORS_ORIGIN=http://localhost:5173,https://dashboard.example.com

# Log verbosity: debug | info | warn | error | silent
LOG_LEVEL=info
